---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getNotes, formatDate } from '../../content-helpers';

export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content } = await render(note);
const d = note.data;
---
<Base title={d.short ?? d.title} description={d.standfirst} active="notes">
<main class="wrap">
  <article class="article">
    <div class="crumbs mono"><a href="/notes/">&larr; Notes</a><span>{formatDate(d.date)}</span><span>{d.tag}</span></div>
    <h1 class="disp">{d.short ?? d.title}</h1>
    {d.standfirst && <p class="standfirst">{d.standfirst}</p>}
    {d.cover && <div class="figure"><Image src={d.cover} alt={d.title} widths={[720, 1440]} sizes="(max-width: 760px) 100vw, 720px" /></div>}
    <div class="body"><Content /></div>
  </article>
</main>
</Base>
