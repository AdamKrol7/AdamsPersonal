---
import Base from '../../layouts/Base.astro';
import { site } from '../../site';
import { getNotes, formatDate } from '../../content-helpers';

const notes = await getNotes();
---
<Base title="Notes" active="notes">
<main class="wrap">

  <header class="page-head">
    <h1 class="disp">Notes</h1>
    <p class="lede">{site.notesLede}</p>
  </header>

  {notes.length > 0 ? (
    <ul class="notes">
      {notes.map((n) => (
        <li>
          <a class="entry" href={`/notes/${n.id}/`}>
            <span class="title">{n.data.title}</span>
            <span class="date mono">{formatDate(n.data.date)}</span>
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <div class="notes-empty mono">First notes coming soon</div>
  )}

</main>
</Base>
