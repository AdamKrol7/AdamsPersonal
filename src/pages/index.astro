---
import Base from '../layouts/Base.astro';
import Tile from '../components/Tile.astro';
import { site } from '../site';
import { getNotes, getProjects } from '../content-helpers';

const notes = (await getNotes()).filter((n) => n.data.home !== undefined);
const projects = (await getProjects()).filter((p) => p.data.home !== undefined);

const tiles = [
  ...notes.map((n) => ({
    pos: n.data.home!,
    title: n.data.tile ?? n.data.short ?? n.data.title,
    label: 'Note',
    href: `/notes/${n.id}/`,
    cover: n.data.cover,
    placeholder: n.data.placeholder ?? n.data.short ?? n.data.title,
  })),
  ...projects.map((p) => ({
    pos: p.data.home!,
    title: p.data.title,
    label: 'Design',
    href: `/design/${p.id}/`,
    cover: p.data.cover,
    placeholder: p.data.placeholder ?? p.data.label,
  })),
].sort((a, b) => a.pos - b.pos);
---
<Base>
<main class="wrap">

  <header class="hero">
    <h1 class="hero-name disp"><span class="w">{site.name[0]}</span> <span class="w">{site.name[1]}</span></h1>
    <div class="hero-sub">
      <span class="role">{site.role}</span>
      <span class="links mono">
        <a href={`mailto:${site.email}`}>Email</a>
        {site.links.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label}</a>)}
      </span>
    </div>
  </header>

  <div class="rule mono"><span>Selected</span><a href="/design/">All work</a></div>

  <section class="grid">
    {tiles.map((t) => <Tile title={t.title} label={t.label} href={t.href} cover={t.cover} placeholder={t.placeholder} />)}
    <Tile title="Everything else" label="Design" href="/design/" placeholder="More" />
  </section>

</main>
</Base>
