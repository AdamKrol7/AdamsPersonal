---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  label: string;
  href?: string;
  cover?: ImageMetadata;
  placeholder?: string;
}
const { title, label, href, cover, placeholder } = Astro.props;
const Tag = href ? 'a' : 'div';
---
<Tag class="piece rv" href={href}>
  <div class="frame">
    {cover
      ? <Image src={cover} alt={title} widths={[480, 800, 1200]} sizes="(max-width: 600px) 100vw, (max-width: 900px) 50vw, 400px" />
      : <div class="ph">{placeholder ?? label}</div>}
  </div>
  <div class="cap"><span class="t">{title}</span><span class="s mono">{label}</span></div>
</Tag>
